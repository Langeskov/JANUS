# JANUS environment template -- NAMES ONLY, never real values.
#
# Copy to a local `.env` (git-ignored) only when a later phase enables a
# provider. Phase 0 runs entirely offline from deterministic fixtures and needs
# NO secrets. Never commit a filled-in .env, never put a value in this file, and
# never paste a credential into a prompt, a log, or an issue.
#
# Reference: Phase 0 spec s9 (security and prompt-injection model).

# Tushare market-data adapter (Phase 0: providers.yaml market_data disabled).
TUSHARE_TOKEN=

# DeepSeek-compatible LLM adapter (Phase 0: providers.yaml llm.enabled=false).
DEEPSEEK_API_KEY=
